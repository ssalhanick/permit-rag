# frontend/.env — Vite dev-only (auto-loaded by npm run dev)
# Copy to frontend/.env (gitignored)

VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# ── Cognito (required — app fails loud without these, see AuthContext.jsx) ──
# Same User Pool as frontend/.env.mobile; get values from AWS Console -> Cognito
# -> User Pools, or copy from frontend/.env.mobile (not loaded for web builds).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REGION=
VITE_COGNITO_GOOGLE_ENABLED=true
